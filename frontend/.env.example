# Real 3D GIS Vector Map Configuration (MapLibre GL JS)
# Default is OpenFreeMap Positron (clean, light, zero rate limits, no API key needed)
VITE_3D_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_TERRAIN_DEM_URL=https://demotiles.maplibre.org/terrain-tiles/tiles.json

# 2D Leaflet Fallback Raster Configuration
VITE_MAP_PROVIDER=osm_standard
VITE_MAP_API_KEY=
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_FALLBACK_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
